apiVersion: v1
kind: Secret
metadata:
  name: odbc-db-config
  # 任意の名前空間を指定（例: default）
  namespace: default
type: Opaque
stringData:
  # ここに実際の接続文字列を記述します
  # stringDataを使うと、Base64エンコード前のプレーンテキストで記述でき、反映時に自動でエンコードされます
  CONNECTION_STRING: "Driver={ODBC Driver 17 for SQL Server};Server=tcp:your-server-address,1433;Database=your-db-name;Uid=your-username;Pwd=your-password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"